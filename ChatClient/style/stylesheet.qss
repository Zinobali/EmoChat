QDialog#LoginDialog {
    background-color: rgb(255, 255, 255)
}

/* 注册界面的提示框 */
#tip_label,
#err_tip[state='normal'] {
    color: green;
}

#tip_label,
#err_tip[state='error'] {
    color: red;
}

/* 图标来控制密码的显示和隐藏 */
#pass_visible[state='unvisible'] {
    border-image: url(:/images/unvisible.png);
}

#pass_visible[state='unvisible_hover'] {
    border-image: url(:/images/unvisible_hover.png);
}

#pass_visible[state='unvisible_press'] {
    border-image: url(:/images/unvisible_press.png);
}

#pass_visible[state='visible'] {
    border-image: url(:/images/visible.png);
}

#pass_visible[state='visible_hover'] {
    border-image: url(:/images/visible_hover.png);
}

#pass_visible[state='visible_press'] {
    border-image: url(:/images/visible_press.png);
}

#confirm_visible[state='unvisible'] {
    border-image: url(:/images/unvisible.png);
}

#confirm_visible[state='unvisible_hover'] {
    border-image: url(:/images/unvisible_hover.png);
}

#confirm_visible[state='unvisible_press'] {
    border-image: url(:/images/unvisible_press.png);
}

#confirm_visible[state='visible'] {
    border-image: url(:/images/visible.png);
}

#confirm_visible[state='visible_hover'] {
    border-image: url(:/images/visible_hover.png);
}

#confirm_visible[state='visible_press'] {
    border-image: url(:/images/visible_press.png);
}

/* 登录页面忘记密码 */
#forget_label[state='normal'],
#forget_label[state='selected'] {
    color: black;
}

#forget_label[state='hover'],
#forget_label[state='selected_hover'] {
    color: rgb(42, 112, 241);
}

#forget_label[state='press'],
#forget_label[state='selected_press'] {
    color: lightblue;
}

/* 聊天页面侧边栏 */
#side_bar {
    background-color: rgb(46, 46, 46);
}

/* 聊天页面添加好友按钮 */
#add_btn[state="normal"] {
    border-image: url(:/images/add_friend_normal.png);
}

#add_btn[state="hover"] {
    border-image: url(:/images/add_friend_hover.png);
}

#add_btn[state="press"] {
    border-image: url(:/images/add_friend_press.png);
}

/* 聊天页面搜索好友控件 */
#search_widget {
    background-color: rgb(247, 247, 247);
}

#search_edit {
    border: 2px solid #f1f1f1;
}

/* 聊天页面list控件 */
#user_widget {
    background-color: rgb(0, 0, 0);
}

#chatting_list {
    background-color: rgb(247, 247, 248);
    border: none;
}

#chatting_list::item:selected {
    background-color: #d3d7d4;
    border: none;
    outline: none;
}

#chatting_list::item:hover {
    background-color: rgb(206, 207, 208);
    border: none;
    outline: none;
}

#chatting_list::focus {
    border: none;
    outline: none;
}

ChatUserWidget {
    background-color: rgb(247, 247, 247);
    border: none;
}

#user_chat_lb {
    color: rgb(153, 153, 153);
    font-size: 12px;
    font-family: "Microsoft YaHei";
}

#user_name_lb {
    color: rgb(0, 0, 0);
    font-size: 14px;
    font-weight: normal;
    font-family: "Microsoft YaHei";
}

#time_widget#time_lb {
    color: rgb(140, 140, 140);
    font-size: 12px;
    font-family: "Microsoft YaHei";
}

/* 整体滚动条样式 */
QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 0px;
}

/* 滚动条滑块样式 */
QScrollBar::handle:vertical {
    background: rgb(173, 170, 169);
    min-height: 10px;
    border-radius: 4px;
}

/* 滚动条的上下按钮 */
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
    border: none;
    background: transparent;
}

/* 滚动条的页面部分 */
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: none;
}

/* 聊天页面工具栏和发送栏 */
#emo_lb[state='normal'] {
    border-image: url(:/images/emo.png);
}

#emo_lb[state='hover'] {
    border-image: url(:/images/emo_hover.png);
}

#emo_lb[state='press'] {
    border-image: url(:/images/emo_press.png);
}

#file_lb[state='normal'] {
    border-image: url(:/images/folder.png);
}

#file_lb[state='hover'] {
    border-image: url(:/images/folder_hover.png);
}

#file_lb[state='press'] {
    border-image: url(:/images/folder_press.png);
}

#send_widget {
    background: #ffffff;
    border: none;
}

#receive_btn[state='normal'] {
    background: #f0f0f0;
    color: #2cb46e;
    font-size: 16px;
    font-family: "Microsoft YaHei";
    border-radius: 20px;
}

#receive_btn[state='hover'] {
    background: #d2d2d2;
    color: #2cb46e;
    font-size: 16px;
    font-family: "Microsoft YaHei";
    border-radius: 20px;
}

#receive_btn[state='press'] {
    background: #c6c6c6;
    color: #2cb46e;
    font-size: 16px;
    font-family: "Microsoft YaHei";
    border-radius: 20px;
}

#send_btn[state='normal'] {
    background: #f0f0f0;
    color: #2cb46e;
    font-size: 16px;
    font-family: "Microsoft YaHei";
    border-radius: 20px;
}

#send_btn[state='hover'] {
    background: #d2d2d2;
    color: #2cb46e;
    font-size: 16px;
    font-family: "Microsoft YaHei";
    border-radius: 20px;
}

#send_btn[state='press'] {
    background: #c6c6c6;
    color: #2cb46e;
    font-size: 16px;
    font-family: "Microsoft YaHei";
    border-radius: 20px;
}

#tool_widget {
    background: #ffffff;
    border-top: 0.5px solid #ececec;
}

#title_widget {
    background: #ffffff;
    border-bottom: 0.5px solid #ececec;
}

#chat_edit {
    background: #ffffff;
    border: none;
    font-family: "Microsoft YaHei";
    font-size: 18px;
    padding: 5px;
}

#chat_bg {
    background: #ffffff;
    border: none;
}

/* 聊天气泡 */
.TextBubble QTextEdit {
    background: transparent;
    border: none;
}